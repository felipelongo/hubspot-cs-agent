# Copy to .env. Never commit .env. If a key is missing, the app uses the mock and says so.

# HubSpot static auth token (private-distribution app, or a legacy private app).
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_ACCOUNT_ID=

# Anthropic. Model ids are configuration, not code.
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_STRONG=

# Optional. When empty, the ledger uses embedded PGlite.
DATABASE_URL=

# Shared password for the demo console. Replace before any real use.
CONSOLE_PASSWORD=

# Public URL of the console, used in task links. Example: http://localhost:8787
PUBLIC_BASE_URL=http://localhost:8787

# HubSpot webhook v3 client secret. Required only for the webhook receiver.
HUBSPOT_WEBHOOK_SECRET=

# shadow | dry_run | live
MODE=shadow

# Set to 1 to make MockHubSpot return occasional 429s.
MOCK_FAULTS=
