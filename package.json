{
  "name": "cs-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cs": "tsx apps/cli/src/main.ts",
    "demo:mock": "tsx apps/cli/src/demo.ts",
    "eval": "tsx packages/evals/src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm eval"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "eslint": "^9.26.0",
    "playwright": "^1.64.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.1.2"
  }
}
